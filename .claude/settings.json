{
  "$schema": "https://www.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 14,
  "permissions": {
    "allow": [
      "Bash(cd *)",
      "Bash(gh issue diff)",
      "Bash(gh issue diff *)",
      "Bash(gh issue list)",
      "Bash(gh issue list *)",
      "Bash(gh issue view)",
      "Bash(gh issue view *)",
      "Bash(gh pr checks)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff)",
      "Bash(gh pr diff *)",
      "Bash(gh pr list)",
      "Bash(gh pr list *)",
      "Bash(gh pr view)",
      "Bash(gh pr view *)",
      "Bash(gh api *)",
      "Bash(gh status)",
      "Bash(gh run view *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(pwd *)",
      "Bash(echo *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(wl-copy *)",
      "Bash(wl-paste *)",
      "Bash(command *)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "enabledPlugins": {
    "plannotator@plannotator": true
  },
  "extraKnownMarketplaces": {
    "plannotator": {
      "source": {
        "source": "github",
        "repo": "backnotprop/plannotator"
      }
    }
  },
  "effortLevel": "high",
  "preferredNotifChannel": "kitty",
  "fileCheckpointingEnabled": false,
  "remoteControlAtStartup": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": false,
  "skipAutoPermissionPrompt": true,

  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "workmux set-window-status waiting",
            "type": "command"
          }
        ],
        "matcher": "permission_prompt|elicitation_dialog"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "async": true,
            "command": "jq -r '.tool_input.questions[0].question // \"Question waiting\"' | { read -r q; notify-send -a Claude --icon=dialog-question \"Claude: ${PWD##*/}\" \"$q\"; } 2>/dev/null || true",
            "type": "command"
          }
        ],
        "matcher": "AskUserQuestion"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "workmux set-window-status working",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "workmux register-agent",
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear|fork"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "workmux set-window-status done",
            "type": "command"
          },
          {
            "async": true,
            "command": "notify-send -a Claude --icon=dialog-information 'Claude: done' \"${PWD##*/}\" 2>/dev/null || true",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "workmux set-window-status working",
            "type": "command"
          }
        ]
      }
    ]
  }
}
